{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/wassa", "destination": "/wassa-percussion", "permanent": true },
    { "source": "/wanevents", "destination": "/wan-events", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(OneEvent|WassaPercussion)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
